# Servidor
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# Base de datos (si se omite DATABASE_URL se usa almacenamiento en memoria; solo desarrollo)
DATABASE_URL=postgres://episafe:episafe_dev@localhost:5432/episafe
DB_POOL_MAX=10

# Seguridad (cambiar en producción; mínimo 32 caracteres)
JWT_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=10

# Servicio de IA
AI_SERVICE_URL=http://localhost:5000
AI_TIMEOUT_MS=4000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
